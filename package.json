{
  "name": "aurelia-jewelry-store",
  "version": "0.1.0",
  "private": true,
  "description": "AURELIA — Bijouterie Without Limits. Online jewelry store.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify": "tsx prisma/verify-catalog.ts",
    "db:verify:runtime": "tsx prisma/verify-runtime-catalog.ts",
    "db:studio": "prisma studio",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/aurelia-db-start.ps1",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/aurelia-db-stop.ps1",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/aurelia-db-status.ps1",
    "db:health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/aurelia-db-health.ps1",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/aurelia-db-backup.ps1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^15",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
