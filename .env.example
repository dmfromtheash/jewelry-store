# AURELIA — example environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# MUST NOT be committed. Do not put real secrets in this example file.

# PostgreSQL connection string used by Prisma (migrate / seed / verify / studio).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# AURELIA's local dev DB runs on port 6700 (isolated — NOT the default 5432,
# which may host an unrelated local cluster). See docs/backend/LOCAL_DB_SETUP.md.
DATABASE_URL="postgresql://aurelia:DEV_PASSWORD@localhost:6700/aurelia?schema=public"

# Admin authentication (Этап 18A) — local/dev sign-in for /admin/* order screens
# and the status-change action. Local-only; never commit real values.
#   ADMIN_USERNAME / ADMIN_PASSWORD — credentials checked at /admin/login.
#   ADMIN_SESSION_SECRET — signs the httpOnly admin session cookie. Use a long
#   random string (32+ chars), e.g. `openssl rand -hex 32`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-your-.env"
ADMIN_SESSION_SECRET="generate-a-long-random-secret-at-least-32-chars"
