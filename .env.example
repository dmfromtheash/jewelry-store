# AURELIA — example environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# MUST NOT be committed. Do not put real secrets in this example file.

# PostgreSQL connection string used by Prisma (migrate / seed / studio).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aurelia?schema=public"
