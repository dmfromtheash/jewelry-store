# Dependencies
node_modules/
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/

# Production build
/build/

# Environment variables — NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Next.js cache
.next/cache/

# TypeScript
*.tsbuildinfo
# next-env.d.ts is tracked (Next.js type reference) — do NOT ignore

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.claude/
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local DB backups — never commit dumps
/backups/
/.local-backups/

# Uploaded product images (binaries) — keep the folder, not the files
/public/uploads/products/*
!/public/uploads/products/.gitkeep
