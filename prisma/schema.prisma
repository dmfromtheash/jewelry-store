// AURELIA — Prisma schema (Этап 15A: backend catalog foundation)
//
// Catalog foundation ONLY. Models here mirror the mock catalog in
// src/data/products.ts and the agreed spec in docs/backend/DATA_MODEL.md.
// User / Order / Cart / Payment / Admin models are intentionally NOT here yet
// (later stages) so the backend stays small and focused.
//
// Conventions (see DATA_MODEL.md):
//   - id: cuid; every entity has createdAt / updatedAt
//   - money: integer MINOR units — never float; currency UAH (Этап 27A; EUR/USD export-ready)
//   - slug: unique, latin only (matches the storefront URLs)
//
// NOTE: 15A does NOT switch the frontend to the DB. The storefront keeps
// reading from src/data/products.ts via src/lib/catalog/*.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Top-level catalog grouping. Today only `bijouterie` and `gifts`.
model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Product status — mirrors the mock `'available' | 'coming-soon'` union.
enum ProductStatus {
  available
  coming_soon
}

/// Core catalog item. Price is server-authoritative and stored in minor units.
model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  /// Storefront caption, e.g. "Серьги · позолота" (mock `category` field).
  categoryLabel String
  status      ProductStatus @default(available)
  /// Storefront visibility (Этап 26L). false hides the product from every public
  /// surface (home/category/search/PDP); the row + order history stay intact.
  /// Defaults true so existing products and admin-created ones are visible.
  isPublished Boolean       @default(true)
  currency    String        @default("UAH")
  /// Integer MINOR units (kopecks); null for coming-soon products.
  price       Int?
  /// Product-level stock (Этап 28B). `null` = NOT tracked (legacy/demo item —
  /// stays purchasable on status+price alone); `0` = out of stock (not
  /// purchasable); `>0` = in stock, decremented by the ordered quantity at
  /// checkout. No variant-level inventory and no reservations yet.
  stockQuantity Int?
  sku         String?
  brand       String?
  description String?
  /// Card badge, e.g. "New" / "Хит".
  tag         String?
  /// Gold badge variant (otherwise dark).
  tagGold     Boolean       @default(false)
  rating      Float         @default(0)
  reviewsCount Int          @default(0)
  /// Spec rows [{ label, value }] for the product detail "Характеристики" tab.
  /// JSON keeps parity with the mock shape without extra tables.
  specs       Json?

  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  images      ProductImage[]
  reviews     ProductReview[]
  wishlistedBy CustomerWishlistItem[]
  interestedBy CustomerProductInterest[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isPublished])
}

/// Selectable option. Today: coating (Позолота / Родирование / Сталь),
/// sourced from the mock `Product.coatings: string[]`.
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Attribute name, e.g. "coating".
  name      String
  /// Attribute value, e.g. "Позолота".
  value     String
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  /// Variant price adjustment in integer MINOR units (kopecks), added to the
  /// product price (Этап 30B). `null`/0 = same as the product price. Pricing
  /// stays server-authoritative: unitPrice = product.price + (priceDelta ?? 0).
  priceDelta Int?
  /// Variant-level stock (Этап 30B). `null` = NOT tracked at the variant level →
  /// falls back to Product.stockQuantity (28B semantics); `0` = out of stock;
  /// `>0` = on hand, decremented by the ordered quantity at checkout.
  stockQuantity Int?
  /// Optional variant SKU, snapshotted onto the order line when present.
  sku       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Keeps the seed idempotent (one row per product+name+value).
  @@unique([productId, name, value])
  @@index([productId])
}

/// Image slot. No real images yet (UI renders a gem placeholder); `url` stays
/// null until real assets exist. `position` reserves the ordered slot.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int
  url       String?
  alt       String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Keeps the seed idempotent (one row per product+position).
  @@unique([productId, position])
  @@index([productId])
}

/// Order lifecycle. Storefront checkout always creates `submitted`; the admin can
/// then move it through a MANUAL fulfillment path (Этап 27E): `submitted` →
/// `processing` (взят в работу) → `completed` (выполнен). `cancelled` and
/// `completed` are terminal. `draft` is reserved for later flows. No payment
/// automation: every transition is a manual, audited admin action.
enum OrderStatus {
  draft
  submitted
  processing
  completed
  cancelled
}

/// A guest checkout order (Этап 16A). Amounts are server-authoritative integer
/// MINOR units (kopecks), recomputed from the catalog — never trusted from the
/// client. No payment / auth / shipping yet.
model Order {
  id             String      @id @default(cuid())
  /// Human-readable code shown to the customer, e.g. "AUR-LX9K2P".
  orderCode      String      @unique
  status         OrderStatus @default(submitted)

  /// Optional owning customer (Этап 47A). NULL = guest checkout (the default,
  /// and what every pre-47A demo order stays). Set server-side from the verified
  /// customer session when a logged-in customer checks out — never trusted from
  /// the client. Loose nullable relation (no cascade): deleting a customer must
  /// never delete their order history, so this is set null on customer delete.
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName   String
  customerPhone  String
  customerEmail  String?
  deliveryCity   String
  /// Manual delivery method key (Этап 27B): self_pickup / nova_poshta /
  /// ukrposhta / local_courier. Allowlisted by src/lib/orders/methods.ts. No
  /// carrier API — this is the customer's chosen method only.
  deliveryMethod String
  /// Optional free-text delivery note (Этап 27B): отделение №, адрес или
  /// комментарий. Intentionally a single line — no structured address model.
  deliveryDetails String?
  /// Optional manual branch / department / warehouse text (Этап 59A). For
  /// Nova Poshta / Ukrposhta this is the customer-typed branch (e.g. "Відділення
  /// №12") — NO carrier API, NO live branch lookup, NO TTN. Plain text only,
  /// length-capped + HTML-stripped server-side (src/lib/orders/validate.ts).
  deliveryBranch String?
  /// Optional manual delivery comment (Этап 59A), kept separate from the legacy
  /// `deliveryDetails` note so the structured branch + a free comment can coexist.
  /// Plain text only, same server-side validation as the other delivery fields.
  deliveryComment String?
  /// Manual payment method key (Этап 27B): cash_on_delivery / manual_online.
  /// Allowlisted by src/lib/orders/methods.ts. No payment provider API — payment
  /// is confirmed manually.
  paymentMethod  String

  subtotalAmount Int         // minor units (kopecks) — sum of line totals BEFORE any discount
  /// Promo discount applied to this order in integer MINOR units (Этап 63A). Default 0,
  /// so every pre-63A order stays valid and unchanged. Server-authoritative: recomputed
  /// from the catalog + the promo rules at checkout, never trusted from the client.
  /// Invariant: 0 <= discountMinor <= subtotalAmount, and totalAmount = subtotalAmount - discountMinor.
  discountMinor  Int         @default(0)
  /// Loose reference to the PromoCode applied (Этап 63A). No FK / no cascade — like
  /// OrderItem.productId, so the order survives a promo being archived/removed. Null = no promo.
  promoCodeId    String?
  /// Snapshot of the normalised promo code text applied (Этап 63A), kept for audit/display
  /// even if the PromoCode is later renamed/archived. Null = no promo.
  promoCode      String?
  totalAmount    Int         // minor units (kopecks) — FINAL total = subtotalAmount - discountMinor
  currency       String      @default("UAH")

  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([customerId])
}

/// Discount kind for a PromoCode (Этап 63A). `percent` uses `percentValue` (whole percent,
/// 1–100); `fixed_amount` uses `amountMinor` (integer minor units).
enum PromoType {
  percent
  fixed_amount
}

/// Manual-checkout promotion / discount code (Этап 63A — promotions foundation).
/// Server-authoritative: a customer may submit only the code STRING; the server recomputes
/// the subtotal from the catalog and the discount from these rules — a client can never set
/// its own discount or total. NO payment-provider / marketing-automation / gift-card / CRM
/// integration: this is a manual-checkout discount only.
///
/// Money + safety by construction:
///   - all money is integer MINOR units (kopecks); percent is a whole-number 1–100. No floats.
///   - `code` is stored normalised UPPERCASE and is unique; lookups normalise the input.
///   - soft-delete only (`archivedAt`) — codes are never hard-deleted, so order history that
///     references a code stays auditable.
///   - `usedCount` is incremented transactionally INSIDE the order commit (guarded by
///     `usageLimit`), so a code can't be over-redeemed under concurrent checkout.
model PromoCode {
  id               String    @id @default(cuid())
  /// Normalised UPPERCASE code the customer types, e.g. "WELCOME10". Unique.
  code             String    @unique
  /// Admin-facing label / internal name (not shown publicly).
  internalName     String
  type             PromoType
  /// Whole percent 1–100 when `type = percent`; null for fixed.
  percentValue     Int?
  /// Discount amount in integer MINOR units when `type = fixed_amount`; null for percent.
  amountMinor      Int?
  /// Currency for a fixed-amount discount; must match the order currency (UAH today).
  currency         String    @default("UAH")
  isActive         Boolean   @default(true)
  /// Optional validity window (inclusive start / exclusive end). Null = unbounded.
  startsAt         DateTime?
  endsAt           DateTime?
  /// Minimum order subtotal (minor units) required to use the code. Null = no minimum.
  minSubtotalMinor Int?
  /// Caps a PERCENT discount at this many minor units. Null = uncapped.
  maxDiscountMinor Int?
  /// Max total redemptions. Null = unlimited. Enforced transactionally via `usedCount`.
  usageLimit       Int?
  /// Successful redemptions so far. Incremented only inside a committed order tx.
  usedCount        Int       @default(0)
  /// Optional admin notes (plain text, validated on write).
  notes            String?
  /// Soft-delete marker (Этап 63A). Non-null = archived/hidden; never hard-deleted.
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isActive])
  @@index([archivedAt])
}

/// Storefront customer account (Этап 47A). Additive + guest-first: accounts are
/// OPTIONAL — guest checkout stays fully supported (Order.customerId may be null).
/// Completely separate from the admin (env-credential) identity: a Customer can
/// NEVER access /admin. Passwords are stored only as a salted scrypt hash
/// (see src/lib/customer/password.ts) — NEVER in plaintext, NEVER logged. The
/// session is a separate httpOnly, HMAC-signed cookie (src/lib/customer/session.ts),
/// distinct from the admin cookie. Only the safe display fields (name/email) are
/// ever surfaced to the client.
model Customer {
  id           String   @id @default(cuid())
  /// Normalised (lowercased, trimmed) email — the login identity. Unique.
  email        String   @unique
  /// Salted scrypt hash, format `scrypt$N$r$p$saltHex$hashHex`. NEVER plaintext.
  passwordHash String
  /// Optional display name (used to prefill checkout + greet in the account).
  name         String?
  /// Optional contact phone (used to prefill checkout).
  phone        String?
  /// Session generation counter (Этап 47C). Signed into the customer session token
  /// (`ver`) and re-checked on every read in getCurrentCustomer. Incremented on
  /// password change, which makes EVERY previously issued token (on any device)
  /// stale → logged out. New accounts start at 1; the current device is re-issued a
  /// fresh token bound to the new value right after a password change.
  sessionVersion Int    @default(1)
  /// When the password was last changed (Этап 47C). Audit/marker only — the
  /// authoritative revocation check is `sessionVersion`. Null until first change.
  passwordChangedAt DateTime?
  /// When this email was verified (Этап 60A). Null = not verified. FOUNDATION only:
  /// because no email provider is configured, a verification link is never delivered
  /// to a real inbox today — this column exists so the verification flow + admin status
  /// are provider-ready. Verification is NOT required for login or guest checkout.
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders        Order[]
  reviews       ProductReview[]
  accountTokens CustomerAccountToken[]
  wishlist      CustomerWishlistItem[]
  savedSearches CustomerSavedSearch[]
  productInterests CustomerProductInterest[]

  @@index([email])
}

/// Server-side account wishlist / favourites (Этап 62A). Persists a logged-in
/// customer's saved products so the wishlist survives across devices/sessions —
/// alongside (not replacing) the guest localStorage favourites. Additive + privacy-safe:
///   - one row per (customerId, productId); the unique constraint makes "add" idempotent.
///   - HARD-SCOPED by customerId everywhere it is read/written (server actions re-derive
///     the owner from the verified session), so one customer can never see/alter another's
///     wishlist.
///   - both sides cascade on delete: removing a customer or a product cleans up its rows,
///     so the wishlist never dangles or leaks a deleted/hidden product as purchasable
///     (the storefront read additionally filters to published products only).
model CustomerWishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

/// Saved catalog search / filter set for a logged-in customer (Этап 69A — account
/// convenience, NOT marketing automation). Stores ONLY safe, validated filter FIELDS
/// (never a raw URL, never HTML/script): the storefront rebuilds a relative /search or
/// /category link from these fields at render time (src/lib/customer/saved-search.ts).
///
/// Privacy + safety by construction:
///   - HARD-SCOPED by `customerId` (server actions re-derive the owner from the verified
///     session), so one customer can never read/alter another's saved searches; cascades on
///     customer delete.
///   - every field is validated/normalised server-side (label length-capped + markup-stripped,
///     query via the catalog search normaliser, categorySlug/sort/status against fixed
///     allowlists, prices clamped to safe integers). No automated email/alert is attached —
///     this is a convenience bookmark only (NO back-in-stock cron, NO notification).
model CustomerSavedSearch {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Customer-facing label (validated plain text, length-capped).
  label        String
  /// Normalised search text (catalog word-prefix search). Null = no text query.
  query        String?
  /// Catalog scope: "bijouterie" | "gifts" (allowlist) or null = sitewide /search.
  categorySlug String?
  /// SortKey from the catalog (validated against the allowlist). Null = default.
  sort         String?
  /// StatusFilter: "all" | "available" | "coming-soon" (validated). Null = all.
  statusFilter String?
  /// Inclusive price bounds in WHOLE UAH (validated non-negative integers). Null = no bound.
  minPrice     Int?
  maxPrice     Int?
  /// Material/coating facet value (validated plain text). Null = no material filter.
  material     String?
  /// When the customer last opened this saved search (audit/UX only). Null until first open.
  lastViewedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
}

/// What a customer is tracking on a product (Этап 69A). Today only `back_in_stock` is wired
/// in the UI; `price_drop` / `general` are reserved enum slots for future use.
enum CustomerInterestType {
  back_in_stock
  price_drop
  general
}

/// Lifecycle of a product interest (Этап 69A). `active` = still waiting; `fulfilled` =
/// the condition was met (admin/owner action — there is NO automatic notification);
/// `cancelled` = the customer withdrew interest.
enum CustomerInterestStatus {
  active
  fulfilled
  cancelled
}

/// Back-in-stock / product-interest FOUNDATION (Этап 69A) — NO real notifications.
/// A logged-in customer can register interest in a product (typically one that is
/// coming-soon / out of stock). This is provider-ready record-keeping ONLY: NOTHING is
/// emailed, NO cron/notification fires, and the customer is never promised a real message.
/// The admin/dashboard may show interest COUNTS so the owner can act manually.
///
/// Privacy + safety by construction:
///   - HARD-SCOPED by `customerId` (server actions re-derive the owner from the verified
///     session); guests cannot register interest (login required). Cascades on customer/
///     product delete so nothing dangles.
///   - the product is resolved by SLUG → a real product server-side (never an arbitrary id);
///     `@@unique([customerId, productId, type])` makes "add" idempotent.
model CustomerProductInterest {
  id          String                 @id @default(cuid())
  customerId  String
  customer    Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId   String
  product     Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        CustomerInterestType   @default(back_in_stock)
  status      CustomerInterestStatus @default(active)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  /// Stamped when the interest is marked fulfilled (manual/owner action). Null while active.
  fulfilledAt DateTime?

  @@unique([customerId, productId, type])
  @@index([customerId])
  @@index([productId])
  @@index([status])
}

/// Purpose of a short-lived, single-use customer account token (Этап 60A).
enum CustomerTokenPurpose {
  password_reset
  email_verification
}

/// Short-lived, single-use account-recovery / email-verification token (Этап 60A).
/// FOUNDATION for password reset + email verification, provider-ready but with NO real
/// email sending (no provider is configured, so a token link is never delivered to a
/// real inbox today).
///
/// Privacy/security by construction:
///   - ONLY the sha256 hash of the random token is stored (`tokenHash`); the raw token
///     never touches the DB, logs, admin UI, or any doc. A stolen DB row cannot be
///     replayed as a token.
///   - single-use: `usedAt` is stamped on consumption and a used/expired token is
///     rejected. Short TTL (see src/lib/customer/account-token.ts).
///   - references the owner by `customerId` only (an opaque cuid, not PII). Cascades on
///     customer delete so tokens never outlive the account.
model CustomerAccountToken {
  id         String              @id @default(cuid())
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purpose    CustomerTokenPurpose
  /// sha256(rawToken) — opaque; the raw token is NEVER stored.
  tokenHash  String              @unique
  /// When the token stops being valid (short TTL).
  expiresAt  DateTime
  /// Stamped when the token is consumed; a non-null value means it can't be reused.
  usedAt     DateTime?
  createdAt  DateTime            @default(now())

  @@index([customerId])
  @@index([purpose])
  @@index([expiresAt])
}

/// Privacy-safe storefront analytics event (Этап 23A). Append-only behavioral
/// signal — NOT business truth (that stays in Order). Follows the contract in
/// docs/backend/ANALYTICS_EVENT_TAXONOMY.md: no raw PII, no secrets, no full IP.
/// References to catalog/order rows are loose ids (no FK) so analytics survives
/// deletions and stays decoupled. Identifiable data is NEVER copied here — only
/// referenced by id. Writes go exclusively through src/lib/analytics/record.ts,
/// which allowlists the event name and strips forbidden payload keys.
model AnalyticsEvent {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  /// Stable snake_case event name from the taxonomy (validated server-side).
  eventName          String
  /// Opaque, rotating, non-identifying session id (never encodes user data).
  anonymousSessionId String?
  /// Reserved for future customer accounts. Null today (no accounts exist).
  userId             String?
  productId          String?
  categoryId         String?
  orderId            String?
  orderCode          String?
  /// Path only (no PII query strings).
  pagePath           String?
  /// Registrable domain only — never the full referrer URL.
  referrerDomain     String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  /// Coarse bucket only: "mobile" | "tablet" | "desktop". No raw user-agent.
  deviceType         String?
  /// Small, sanitized JSON. MUST NOT hold secrets/cookies/PII/full payment.
  payload            Json?
  /// Optional consent/DNT flags. No identities.
  privacyFlags       Json?

  @@index([createdAt])
  @@index([eventName])
  @@index([productId])
  @@index([categoryId])
  @@index([orderCode])
}

/// Append-only admin/security audit trail (Этап 21A). Records important admin
/// actions for accountability — login success/failure, logout, order status
/// changes. Privacy-first: rows MUST NOT contain secrets, session cookies,
/// passwords, the session secret, full payment data, or unnecessary customer
/// PII (see docs/backend/SECURITY_NOTES.md and ADMIN_AUDIT_LOG.md). Designed to
/// support future roles/users without requiring an AdminUser model yet — the
/// actor is just a string (today the session subject or "anonymous").
model AdminAuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  /// Who acted. Today: the admin session subject (username) on authenticated
  /// actions, or "anonymous" for failed/throttled logins. Not a secret.
  actor      String
  /// Stable action identifier, e.g. "admin.login.success".
  action     String
  /// Whether the action succeeded (false for failed/refused logins).
  success    Boolean  @default(true)
  /// Optional target entity type, e.g. "order".
  entityType String?
  /// Optional target entity id/code, e.g. an order code. Never raw PII.
  entityId   String?
  /// Short, human-readable summary. Safe by construction — no secrets/PII.
  summary    String
  /// Optional machine reason, e.g. "invalid_credentials" / "throttled".
  reason     String?
  /// Optional minimal structured context (e.g. status transition). MUST NOT
  /// hold secrets, cookies, passwords, full payment data, or raw customer PII.
  metadata   Json?

  @@index([createdAt])
  @@index([action])
}

/// Durable customer-auth rate-limit counter (Этап 51A). Replaces the 49A
/// in-memory-only throttle for single-instance public-demo readiness: counts
/// survive a server restart / HMR. One row per (scope + identifier) fixed window.
///
/// Privacy by construction — this table NEVER stores a password, cookie, token,
/// secret, raw header, IP, or email. The identifier (IP for anonymous flows,
/// Customer.id for authenticated ones) is folded into `keyHash` (sha256), so only
/// an opaque digest is persisted; `scope` is a safe machine label.
model CustomerAuthThrottle {
  id          String   @id @default(cuid())
  /// sha256("<scope>:<identifier>") — opaque; the raw IP/customer id is never stored.
  keyHash     String   @unique
  /// Safe machine label: "login" | "register" | "password" | "profile".
  scope       String
  /// Attempts recorded in the CURRENT window.
  count       Int      @default(0)
  /// When the current window opened.
  windowStart DateTime @default(now())
  /// When the current window ends; a later attempt lazily opens a fresh window.
  resetAt     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([resetAt])
  @@index([scope])
}

/// Immutable line snapshot captured at order time (name/price/sku copied so the
/// order is stable even if the product later changes). `productId` is nullable
/// so the order survives product deletion.
model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String?
  productSlug String
  productName String
  productSku  String?

  /// Variant snapshot (Этап 30B). Loose id — NO FK / NO cascade — so the order
  /// survives variant deletion, exactly like `productId?`. Null on a product
  /// ordered without variants (and on every pre-30B order).
  variantId    String?
  /// Attribute name snapshot, e.g. "coating".
  variantName  String?
  /// Attribute value snapshot, e.g. "Позолота".
  variantValue String?
  /// Which inventory level this line decremented at order time (Этап 30B):
  /// "variant" → ProductVariant.stockQuantity, "product" → Product.stockQuantity,
  /// `null` → untracked (nothing decremented). Recorded so restock-on-cancel (28C)
  /// re-increments the EXACT level that was decremented, even if an admin later
  /// flips a variant between tracked/untracked between order and cancellation.
  stockSource  String?

  unitPrice   Int      // minor units (kopecks) snapshot
  quantity    Int
  lineTotal   Int      // minor units (kopecks) = unitPrice * quantity

  createdAt   DateTime @default(now())

  @@index([orderId])
}

/// Value/validation kind for a SiteSetting (Этап 46C). Lowercase members match the
/// repo enum convention (cf. ProductStatus / OrderStatus).
enum SiteSettingType {
  text
  long_text
  email
  phone
  url
}

/// Owner-editable site setting (Этап 46C — Admin CMS foundation). Safe key-value
/// store for PUBLIC business copy/settings ONLY (brand name, contacts, social
/// links, footer copy). NEVER secrets, NEVER markup/layout/design. Keys come from
/// a FIXED code allowlist (src/lib/site-settings/defaults.ts); values are plain
/// text, validated + audited on write. Additive: the storefront does not read this
/// yet — header/footer/contact integration is the separate 46D stage.
model SiteSetting {
  id        String          @id @default(cuid())
  /// Stable dotted key from the code allowlist, e.g. "brand.displayName".
  key       String          @unique
  /// Admin-facing field label (code-owned, not user-edited).
  label     String
  /// UI grouping: brand | contacts | social | footer (code-owned).
  group     String
  /// Validation/render type for the value.
  type      SiteSettingType
  /// Plain-text value (no HTML). Empty allowed for optional fields.
  value     String
  /// Whether the value is safe to render publicly. Always true in v1 (these are
  /// public business fields); reserved so 46D fallback can skip unpublished rows.
  isPublic  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

/// Owner-editable public info page (Этап 46E — Info Pages CMS). Stores the SAME
/// shape the storefront already renders (src/data/info-pages.ts → InfoPageLayout):
/// title + SEO meta + optional intro/notice + a strict `sections` JSON array
/// ({ heading?, paragraphs?[], bullets?[], faq?[] }). PLAIN TEXT only — validated +
/// audited on write; NEVER raw HTML/scripts, NEVER a freeform page builder. Slugs
/// come from the FIXED known-page allowlist (src/lib/site-pages/defaults.ts, sourced
/// from info-pages.ts). Additive + fallback-first: the static info-pages.ts stays as
/// the default/fallback, so a missing/unpublished/invalid row renders the same page.
model SitePage {
  id              String   @id @default(cuid())
  /// Known page slug: delivery | returns | stores | help | about | contacts.
  slug            String   @unique
  title           String
  /// SEO <title>; mirrors InfoPage.metaTitle.
  metaTitle       String
  /// SEO meta description; mirrors InfoPage.metaDescription.
  metaDescription String
  /// Optional lead paragraph.
  intro           String?
  /// Optional highlighted pre-launch notice.
  notice          String?
  /// InfoSection[] as validated JSON (heading/paragraphs/bullets/faq). Plain text
  /// only; shape + length/count limits enforced on every write (and re-checked on
  /// read — an invalid blob falls back to the static default).
  sections        Json
  /// false hides the DB content → the storefront falls back to the static default.
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Moderation status for a product review (Этап 59A). Every storefront submission
/// starts `pending` and is invisible publicly until an admin `approved` it.
enum ReviewStatus {
  pending
  approved
  rejected
}

/// Moderated product review / rating (Этап 59A — social proof foundation).
/// Privacy + safety by construction:
///   - stores ONLY safe fields: a 1–5 rating, a public display name, the review
///     body, the moderation status, and an optional loose link to the Customer
///     who submitted it while logged in. NEVER an email, phone, IP, token, or any
///     secret — contact data stays on the Order/Customer, never copied here.
///   - all text is length-capped + HTML/script-stripped server-side before write
///     (src/lib/reviews/validate.ts); raw markup is never persisted or rendered.
///   - `status` defaults to `pending`: the public PDP shows `approved` reviews only,
///     so an unmoderated or rejected review is never publicly visible.
///   - `isDemo` flags seeded/sample reviews so they are never misrepresented as real
///     verified-purchase reviews (there is no purchase-verification here).
model ProductReview {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Optional owning customer (set server-side from the verified session when the
  /// author is logged in). NULL = submitted as a guest. Loose nullable relation
  /// (set null on customer delete) so review history survives an account deletion.
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Public display name shown next to the review. Plain text, validated.
  authorName  String
  /// Integer 1–5 (enforced in validation, not the DB type).
  rating      Int
  /// Review text. Plain text only (HTML stripped), length-capped on write.
  body        String
  status      ReviewStatus @default(pending)
  /// True for seeded/sample reviews — keeps demo content honestly labelled.
  isDemo      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  /// When an admin approved/rejected it (audit marker). Null while pending.
  moderatedAt DateTime?

  @@index([productId, status])
  @@index([status])
}

/// Stable identifier for a future transactional email (Этап 59A). NO email is sent
/// for any of these yet — these are the template slots the email foundation reserves.
enum EmailTemplate {
  order_confirmation
  order_status_update
  password_reset
  email_verification
}

/// Honest lifecycle for an outbox row (Этап 59A; processing + provider results 60A).
/// There is NO email provider, so the only real terminal states today are
/// `skipped_no_provider` (a deliverable intent recorded but not sent — no provider) and
/// `failed_validation` (e.g. a guest order with no email address). A row starts `queued`
/// and the no-send processor (src/lib/email/process.ts) moves it to a terminal state.
/// `sent_stub` / `failed_stub` exist for FUTURE provider wiring + are exercised by the
/// verify script; the legacy `skipped` value is retained for back-compat. Nothing here
/// ever contacts a real mail server.
enum EmailOutboxStatus {
  queued
  sent_stub
  skipped
  skipped_no_provider
  failed_stub
  failed_validation
}

/// Email operations FOUNDATION (Этап 59A) — a queue/record of intended emails, with
/// NO real sending. This deliberately does NOT integrate any provider (SendGrid /
/// Mailgun / SMTP), holds NO provider credentials, and never contacts a mail server:
/// rows are recorded for future wiring and admin visibility only.
///
/// Privacy + safety by construction:
///   - stores ONLY a template id, a status, a short safe `subject`, an optional
///     machine `note`, and a loose (no-FK) reference to the related order/customer.
///   - the rendered email BODY is intentionally NOT stored (it could embed PII), and
///     NO token/secret/reset-code is ever stored here (password-reset tokens are a
///     deferred, owner/provider-gated concern — see docs/customer spec).
///   - `recipientEmail` is stored ONLY when the address was already supplied by the
///     order/customer; it is never invented or harvested.
model EmailOutbox {
  id             String            @id @default(cuid())
  template       EmailTemplate
  status         EmailOutboxStatus @default(queued)
  /// Recipient address — only when already supplied by the order/customer; else null.
  recipientEmail String?
  /// Loose reference type, e.g. "order" | "customer". No FK (survives deletion).
  relatedType    String?
  /// Loose reference id/code, e.g. an order code. Never raw PII.
  relatedId      String?
  /// Short, safe subject line. No secrets/PII beyond what a subject needs.
  subject        String
  /// Optional machine note, e.g. "no email provider configured — not sent".
  note           String?
  /// How many times the no-send processor has touched this row (Этап 60A). 0 until
  /// first processed; bounded by the processor (a terminal row is not re-processed).
  attempts       Int               @default(0)
  /// Short, SAFE machine summary of the last processing outcome (Этап 60A), e.g.
  /// "no email provider configured" / "missing recipient". NEVER a token, secret,
  /// stack trace, raw provider payload, or message body.
  lastError      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  /// When the row reached a terminal state (skipped_no_provider / sent_stub / failed_*).
  processedAt    DateTime?

  @@index([status])
  @@index([template])
}
